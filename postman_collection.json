{
  "info": {
    "name": "API Bibliothèque",
    "description": "Tests de l'API de la bibliothèque (livres et utilisateurs).\n\nExécutez la collection dans l'ordre avec le Runner : chaque élément créé est supprimé à la fin, on peut donc la relancer autant de fois que nécessaire.\n\nChangez la variable baseUrl pour tester la version déployée sur Heroku.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Général",
      "item": [
        {
          "name": "Accueil de l'API",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Code HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            }
          }
        },
